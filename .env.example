# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redispassword"

# SMTP (MailHog for development)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ReachInbox <no-reply@reachinbox.local>"

# Worker Configuration
WORKER_CONCURRENCY=5
DEFAULT_HOURLY_LIMIT=200
DEFAULT_MIN_DELAY_MS=2000
LEASE_DURATION_SECONDS=60
LEASE_HEARTBEAT_SECONDS=20

# Elasticsearch
ELASTICSEARCH_NODE="http://localhost:9200"
ELASTICSEARCH_INDEX="reachinbox_email_logs"
